# =============================================================================
# .gitignore for HVAC_DRL_MORL — Q1 paper submission repository
# =============================================================================
# Strategy:
#   - INCLUDE: code, configs, reports/*.csv (audit evidence), paper sources, DOCX
#   - EXCLUDE: large training outputs, model checkpoints, raw data files
#   - Large artifacts (models, training traces, raw BOPTEST corpora) should be
#     published separately on Zenodo with a DOI cross-referenced from README.md
# =============================================================================

# ─── Python ───
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Virtual environments ───
.venv/
venv/
env/
ENV/

# ─── Node / npm ───
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── IDE / OS ───
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Claude / agent state ───
.claude/
.claude-cache/

# =============================================================================
# Heavy training artifacts (regenerable from code + configs)
# Publish on Zenodo if reviewers need them for verification.
# =============================================================================

# Training output directories — all PPO/HDRL/MORL run artifacts
outputs/

# Model checkpoints (large binary files)
models/
*.pt
*.pth
*.pkl
*.h5
*.onnx

# BOPTEST simulator binaries
*.fmu

# Training logs (TensorBoard, etc.)
logs/
*.tfevents.*
runs/

# =============================================================================
# Large raw data files (publish on Zenodo)
# =============================================================================

# Surrogate training corpora — 51,200 hourly + 15-min BOPTEST corpora (~50 MB)
data/surrogate_v2/boptest_v2_*.csv
data/block_1_2_surrogate_rmse/*.csv
data/raw/

# Block 3 testcase data (large; archive on Zenodo)
data/block3_bestest_hydronic/
data/block3_bestest_hydronic_heat_pump/
data/block3_singlezone_commercial_hydronic/
data/surrogate/

# Docker volume mounts
docker/volumes/
boptest_rte/data/
boptest_rte/

# =============================================================================
# Jupyter
# =============================================================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# =============================================================================
# Temporary / draft / one-off patch files
# =============================================================================
*.tmp
*.bak
*.log
*~
$null
docs/_tmp_*
docs/patch_*.py           # one-off DOCX patch scripts (history preserved via git log)

# LaTeX intermediates. Regenerated by every pdflatex/bibtex run, so they churn
# on each rebuild. .bbl is NOT here: journals want the resolved bibliography
# next to the .tex, and several are tracked on purpose.
docs/**/*.aux
docs/**/*.blg
docs/**/*.out
docs/**/*.toc
docs/**/*.fls
docs/**/*.fdb_latexmk
docs/**/*.synctex.gz

# Legacy/generated figure output directory. Final paper-facing figures, tables,
# CSV evidence, and manifests are consolidated under paper_artifacts/.
reports/figures/

# =============================================================================
# Sensitive / secrets — NEVER commit
# =============================================================================
.env
.env.local
*.pem
*.key
credentials.json
secrets/

# =============================================================================
# Files explicitly KEPT (not excluded — listed here for clarity, not as patterns):
# =============================================================================
#   reports/*.csv        — audit evidence (Block 1/2/3 KPI artifacts)
#   reports/*.json       — audit evidence (decomposition, per-seed)
#   reports/*.md         — narrative reports
#   paper_artifacts/      — canonical paper-facing figures, tables, CSV evidence, manifests
#   configs/*.yaml       — training configs + pre-registration manifests
#   configs/**/*.yaml    — nested configs
#   docs/**/*.tex        — manuscript sources per journal port
#   docs/**/build_*.py   — reproducible manuscript build scripts
#   *.tex                — LaTeX sources
#   *.bib                — bibliography
#   *.md                 — Markdown docs (README, roadmap, etc.)
#   Dockerfile           — container definition
#   requirements.txt     — Python dependencies

# =============================================================================
# Reference library and regenerable bundles (kept locally, not in history)
# =============================================================================

# Downloaded third-party papers used for the related-work review (~230 MB).
# Personal reading copies; not ours to redistribute, and they would sit in the
# git history forever.
docs/related_works/
docs/example_article_ASEJ.pdf

# Submission bundles: rebuilt from the LaTeX sources by the per-journal
# build_*.py scripts, so the zip itself carries no information the sources lack.
docs/*.zip

# Scratch
tmp/
