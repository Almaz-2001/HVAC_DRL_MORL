\@writefile{toc}{\contentsline {paragraph}{Thermostatic PPO negative control and hybrid recovery.}{16}{paragraph*.15}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {The fidelity--utility paradox at a glance.} For the four thermostatic-PPO backends the measured chain runs \textbf  {(A)} 24\,h rollout RMSE $\to $ \textbf  {(B)} action-surface roughness $\to $ \textbf  {(C)} policy saturation $\to $ \textbf  {(D)} live maintenance score $m_s$. The higher-fidelity backends (calibrated GB, matched-resolution BB) win on (A) yet are rougher, saturate, and collapse in (D) ($m_s>1$), while the coarse hourly BB and the hybrid stay usable, and the contradiction between (A) and (D) is the paradox. For the hybrid, panel~\textbf  {(A)} shows the BB rollout RMSE because the hybrid rolls out on BB; GB enters only as a frozen reward censor, so the hybrid has no independent 24\,h predictive RMSE (hence the ``---'' in Table~\ref {tab:paradox}). Panel~\textbf  {(D)} reports the cross-window mean of the peak and typical maintenance scores (per-window values in Table~\ref {tab:paradox}).}}{16}{figure.caption.16}\protected@file@percent }
\newlabel{fig:evidence_chain}{{4}{16}{\textbf {The fidelity--utility paradox at a glance.} For the four thermostatic-PPO backends the measured chain runs \textbf {(A)} 24\,h rollout RMSE $\to $ \textbf {(B)} action-surface roughness $\to $ \textbf {(C)} policy saturation $\to $ \textbf {(D)} live maintenance score $m_s$. The higher-fidelity backends (calibrated GB, matched-resolution BB) win on (A) yet are rougher, saturate, and collapse in (D) ($m_s>1$), while the coarse hourly BB and the hybrid stay usable, and the contradiction between (A) and (D) is the paradox. For the hybrid, panel~\textbf {(A)} shows the BB rollout RMSE because the hybrid rolls out on BB; GB enters only as a frozen reward censor, so the hybrid has no independent 24\,h predictive RMSE (hence the ``---'' in Table~\ref {tab:paradox}). Panel~\textbf {(D)} reports the cross-window mean of the peak and typical maintenance scores (per-window values in Table~\ref {tab:paradox})}{figure.caption.16}{}}
\newlabel{fig:evidence_chain@cref}{{[figure][4][]4}{[1][16][]16}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Central fidelity--utility paradox. The four thermostatic-PPO training backends of the taxonomy (Table~\ref {tab:taxonomy}), each trained on its surrogate and evaluated zero-shot in closed loop on the live BOPTEST \texttt  {bestest\_air} runtime over the peak/typical 14-day windows. Predictive fidelity (24\,h rollout RMSE; lower is more accurate) is set against live control utility (maintenance score $m_s$, with $m_s>1$ unusable, and comfort violation). Higher predictive fidelity does not imply usability: both finer backends collapse, whereas the role-separated hybrid is robust. The matched-resolution BB row isolates the model-class confound (Section~\ref {sec:mechanism-hybrid}); per-window live closed-loop RMSE and energy are broken out in Supplementary Figure~S7.}}{16}{table.caption.17}\protected@file@percent }
\newlabel{tab:paradox}{{4}{16}{Central fidelity--utility paradox. The four thermostatic-PPO training backends of the taxonomy (Table~\ref {tab:taxonomy}), each trained on its surrogate and evaluated zero-shot in closed loop on the live BOPTEST \texttt {bestest\_air} runtime over the peak/typical 14-day windows. Predictive fidelity (24\,h rollout RMSE; lower is more accurate) is set against live control utility (maintenance score $m_s$, with $m_s>1$ unusable, and comfort violation). Higher predictive fidelity does not imply usability: both finer backends collapse, whereas the role-separated hybrid is robust. The matched-resolution BB row isolates the model-class confound (Section~\ref {sec:mechanism-hybrid}); per-window live closed-loop RMSE and energy are broken out in Supplementary Figure~\suppref {S7}}{table.caption.17}{}}
\newlabel{tab:paradox@cref}{{[table][4][]4}{[1][16][]16}{}{}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Predictive fidelity versus live control utility. Lower rollout RMSE can raise live $m_s$; the hybrid returns to the usable region. Filled/open markers denote peak/typical windows; markers are the canonical seed-42 $m_s$ and error bars are $\pm 1$ seed s.d.\ over $N=3$ seeds for all four backends, including direct GB (Table~S14).}}{17}{figure.caption.18}\protected@file@percent }
\newlabel{fig:paradox_scatter}{{5}{17}{Predictive fidelity versus live control utility. Lower rollout RMSE can raise live $m_s$; the hybrid returns to the usable region. Filled/open markers denote peak/typical windows; markers are the canonical seed-42 $m_s$ and error bars are $\pm 1$ seed s.d.\ over $N=3$ seeds for all four backends, including direct GB (Table~\suppref {S14})}{figure.caption.18}{}}
\newlabel{fig:paradox_scatter@cref}{{[figure][5][]5}{[1][16][]17}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Live BOPTEST maintenance-score decomposition. Direct GB fails through sustained out-of-band time; pure BB and the hybrid keep duration and severity small.}}{17}{figure.caption.19}\protected@file@percent }
\newlabel{fig:ms_decomp}{{6}{17}{Live BOPTEST maintenance-score decomposition. Direct GB fails through sustained out-of-band time; pure BB and the hybrid keep duration and severity small}{figure.caption.19}{}}
