\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {Surrogates make policy-gradient training computationally feasible.} Environment throughput (env steps/s, log scale) versus 24\,h rollout RMSE$_T$ for the BOPTEST emulator (ground truth) and the three in-process surrogate backends. The surrogates run $85$--$220\times $ faster than the BOPTEST RTE HTTP testbed, turning a days-long PPO run into hours; the hybrid is plotted at v3's rollout RMSE because it rolls out on v3. The plotted values combine measured throughput with 24\,h rollout-RMSE estimates.}}{7}{figure.caption.17}\protected@file@percent }
\newlabel{fig:runtime_feasibility}{{S5}{7}{\textbf {Surrogates make policy-gradient training computationally feasible.} Environment throughput (env steps/s, log scale) versus 24\,h rollout RMSE$_T$ for the BOPTEST emulator (ground truth) and the three in-process surrogate backends. The surrogates run $85$--$220\times $ faster than the BOPTEST RTE HTTP testbed, turning a days-long PPO run into hours; the hybrid is plotted at v3's rollout RMSE because it rolls out on v3. The plotted values combine measured throughput with 24\,h rollout-RMSE estimates}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces Hybrid reward-shaping mechanism. v3 supplies rollout dynamics; frozen v3.5 supplies a disagreement penalty on the same state-action transition.}}{7}{figure.caption.18}\protected@file@percent }
\newlabel{fig:hybrid_reward}{{S6}{7}{Hybrid reward-shaping mechanism. v3 supplies rollout dynamics; frozen v3.5 supplies a disagreement penalty on the same state-action transition}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces Detailed live BOPTEST KPI breakdown (per-metric bars) for pure v3, direct v3.5, and hybrid PPO. Direct v3.5 is a negative control: higher predictive fidelity does not imply a useful RL training environment. These per-metric bars give the underlying $m_s$, violation, RMSE, and energy behind the compact fidelity--utility scatter in the main text.}}{8}{figure.caption.19}\protected@file@percent }
\newlabel{fig:live_kpi}{{S7}{8}{Detailed live BOPTEST KPI breakdown (per-metric bars) for pure v3, direct v3.5, and hybrid PPO. Direct v3.5 is a negative control: higher predictive fidelity does not imply a useful RL training environment. These per-metric bars give the underlying $m_s$, violation, RMSE, and energy behind the compact fidelity--utility scatter in the main text}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces Action-density phase portrait of the three thermostatic controllers on the live BOPTEST \texttt  {typical\_heat\_window}: empirical hexbin density of the normalised supply-temperature action $a_0$ (one hue per backend) against the thermal error $T_{\mathrm  {zone}}-T_{\mathrm  {set}}$, on \emph  {identical} axes, with the marginal $a_0$ distribution in the right strip of each panel and the measured saturation share ($|a_0|\geq 0.9$). The red bands mark the actuator-saturation region. Direct v3.5 collapses onto $a_0=-1$ (100\% saturation, a bang-bang law) whereas the usable hourly v3 and the hybrid modulate ($\approx $19--20\%).}}{8}{figure.caption.20}\protected@file@percent }
\newlabel{fig:action_phase}{{S8}{8}{Action-density phase portrait of the three thermostatic controllers on the live BOPTEST \texttt {typical\_heat\_window}: empirical hexbin density of the normalised supply-temperature action $a_0$ (one hue per backend) against the thermal error $T_{\mathrm {zone}}-T_{\mathrm {set}}$, on \emph {identical} axes, with the marginal $a_0$ distribution in the right strip of each panel and the measured saturation share ($|a_0|\geq 0.9$). The red bands mark the actuator-saturation region. Direct v3.5 collapses onto $a_0=-1$ (100\% saturation, a bang-bang law) whereas the usable hourly v3 and the hybrid modulate ($\approx $19--20\%)}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S9}{\ignorespaces Across $N=3$ seeds the fidelity--utility paradox is not a seed result: the usable hourly-v3 and hybrid controllers stay below both the $m_s=1$ closed-loop-collapse line and the $5\%$ comfort-violation reference on every seed, while the matched-resolution v3 and the direct v3.5 both collapse on every seed ($m_s>1$, $>75\%$ violation) with small seed variance. Markers are the mean over seeds \{42,43,44\} (filled = peak-heat window, open = typical-heat window); whiskers are $\pm $ one standard deviation; colour encodes the controller (green = coarse v3, salmon = matched-resolution v3, purple = direct v3.5, blue = hybrid). \textbf  {(left)} live maintenance score $m_s$ (lower is better, with the usable $m_s<0.1$ band shaded); \textbf  {(right)} comfort-violation fraction. Same data as Table~\ref {tab:seed_band}.}}{9}{figure.caption.21}\protected@file@percent }
\newlabel{fig:seed_band}{{S9}{9}{Across $N=3$ seeds the fidelity--utility paradox is not a seed result: the usable hourly-v3 and hybrid controllers stay below both the $m_s=1$ closed-loop-collapse line and the $5\%$ comfort-violation reference on every seed, while the matched-resolution v3 and the direct v3.5 both collapse on every seed ($m_s>1$, $>75\%$ violation) with small seed variance. Markers are the mean over seeds \{42,43,44\} (filled = peak-heat window, open = typical-heat window); whiskers are $\pm $ one standard deviation; colour encodes the controller (green = coarse v3, salmon = matched-resolution v3, purple = direct v3.5, blue = hybrid). \textbf {(left)} live maintenance score $m_s$ (lower is better, with the usable $m_s<0.1$ band shaded); \textbf {(right)} comfort-violation fraction. Same data as Table~\ref {tab:seed_band}}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S10}{\ignorespaces Warm-start negative control. Pretraining on direct v3.5 and then fine-tuning on the hybrid backend is inferior to training the hybrid policy from scratch.}}{9}{figure.caption.22}\protected@file@percent }
\newlabel{fig:warmstart}{{S10}{9}{Warm-start negative control. Pretraining on direct v3.5 and then fine-tuning on the hybrid backend is inferior to training the hybrid policy from scratch}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S11}{\ignorespaces Transfer-gap diagnostics. Direct v3.5 has high action-gap norm and live-surrogate mismatch; the hybrid backend suppresses both.}}{10}{figure.caption.23}\protected@file@percent }
\newlabel{fig:transfer_gap}{{S11}{10}{Transfer-gap diagnostics. Direct v3.5 has high action-gap norm and live-surrogate mismatch; the hybrid backend suppresses both}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S12}{\ignorespaces HDRL architecture: a high-level seasonal gate $k(t)$ routes the 17D observation to one of two low-level PPO setpoint specialists (winter / summer). Because the low level is already comfort-aware, the v3.5 temperature censor over-regularizes it.}}{10}{figure.caption.24}\protected@file@percent }
\newlabel{fig:hdrl_arch}{{S12}{10}{HDRL architecture: a high-level seasonal gate $k(t)$ routes the 17D observation to one of two low-level PPO setpoint specialists (winter / summer). Because the low level is already comfort-aware, the v3.5 temperature censor over-regularizes it}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S13}{\ignorespaces \textbf  {The optimal censor weight $\lambda _T$ is controller-family specific.} Live BOPTEST maintenance score $m_s$ (cross-window mean of the peak and typical windows) versus $\lambda _T$ for each controller family; $\star $ marks the per-family optimum. Thermostatic PPO improves with the censor (optimum $\lambda _T=0.10$, the canonical hybrid), HDRL is best \emph  {without} it ($\lambda _T=0.00$) and degrades monotonically, and MORL adopts $\lambda _T=0.00$. HDRL has a dense four-point sweep; PPO is shown at its two measured endpoints (pure v3 $=\lambda _T0$, hybrid $=0.10$) and MORL at its single adopted configuration. The panel compares the \emph  {location} of each optimum, not absolute $m_s$ across families (they use different observation/action interfaces).}}{11}{figure.caption.25}\protected@file@percent }
\newlabel{fig:lambda_specificity}{{S13}{11}{\textbf {The optimal censor weight $\lambda _T$ is controller-family specific.} Live BOPTEST maintenance score $m_s$ (cross-window mean of the peak and typical windows) versus $\lambda _T$ for each controller family; $\star $ marks the per-family optimum. Thermostatic PPO improves with the censor (optimum $\lambda _T=0.10$, the canonical hybrid), HDRL is best \emph {without} it ($\lambda _T=0.00$) and degrades monotonically, and MORL adopts $\lambda _T=0.00$. HDRL has a dense four-point sweep; PPO is shown at its two measured endpoints (pure v3 $=\lambda _T0$, hybrid $=0.10$) and MORL at its single adopted configuration. The panel compares the \emph {location} of each optimum, not absolute $m_s$ across families (they use different observation/action interfaces)}{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S14}{\ignorespaces HDRL $\lambda _T$ sensitivity. The thermostatic regularization weight does not transfer; the best HDRL policy uses no temperature-disagreement term.}}{11}{figure.caption.26}\protected@file@percent }
\newlabel{fig:hdrl_sweep}{{S14}{11}{HDRL $\lambda _T$ sensitivity. The thermostatic regularization weight does not transfer; the best HDRL policy uses no temperature-disagreement term}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S15}{\ignorespaces MORL observation-interface schematic. The 5D instantaneous observation fails because it is blind to forecasted disturbances, whereas the 17D forecast-augmented observation makes MORL control-viable. The quantitative ablation of this schematic is in Figure~\ref {fig:morl5d17d_supp}.}}{12}{figure.caption.27}\protected@file@percent }
